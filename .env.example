# faraday (React Native) — BangSoal mobile app.
# Copy this file to `.env` for local development.
#
# NOTE: React Native does not read this file automatically yet. When we wire
# env loading, keep these names as the public app-side contract.

NODE_ENV=development

# --- Backend (newton) ---
API_URL=http://localhost:8080
PUBLIC_API_URL=http://localhost:8080/api

# --- Auth ---
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# --- Payments (Midtrans) ---
MIDTRANS_CLIENT_KEY=
MIDTRANS_URL=

# --- Analytics ---
MIXPANEL_TOKEN=

# --- Error reporting ---
SENTRY_DSN=
